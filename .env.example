DATABASE_URL=postgres://discord:discord@localhost:5432/discord
# If 5432 is already occupied: POSTGRES_PORT=5433 and update DATABASE_URL to match.
REDIS_URL=redis://localhost:6379
DISCORD_TOKEN=replace-me
API_BIND=127.0.0.1:3001
API_CORS_ORIGIN=http://127.0.0.1:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://127.0.0.1:3001/api/auth
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
# Comma-separated Discord user IDs allowed to use bot-wide owner routes.
BOT_OWNER_DISCORD_IDS=312058643210567680
# Explicitly opt in only for local development without Discord OAuth.
AUTH_DEVELOPMENT_BYPASS=false
RUST_LOG=info,sqlx=warn

# apps/web/.env.local
# Use same-origin with Vite's local proxy, or set the deployed API origin.
# VITE_API_BASE_URL=same-origin

