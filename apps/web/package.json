{
  "name": "orivane-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src --react-plugin --jsx-a11y-plugin --import-plugin --vitest-plugin -A vitest/require-mock-type-parameters -A vitest/no-conditional-expect -A react/incompatible-library -A react/set-state-in-effect -A react/purity -A jsx-a11y/prefer-tag-over-role -A jsx-a11y/no-noninteractive-element-interactions --deny-warnings --report-unused-disable-directives",
    "doctor": "react-doctor . --yes --no-supply-chain --no-score --blocking warning --no-color",
    "check": "pnpm typecheck && pnpm lint && pnpm run doctor && pnpm test:coverage && pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tanstack/charts": "1.1.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.12",
    "better-auth": "1.7.12",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router-devtools": "1.167.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "react-doctor": "^0.9.18",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.4.1"
}
