FROM rust:1.94-bookworm AS builder

WORKDIR /workspace

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY crates ./crates
COPY modules ./modules

RUN --mount=type=cache,id=orivane-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=orivane-rust-target,target=/workspace/target \
    cargo build --locked --release \
      --package discord-bot-api \
      --package discord-bot-gateway \
    && mkdir /orivane-binaries \
    && cp target/release/discord-bot-api target/release/discord-bot-gateway /orivane-binaries/

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 orivane

ARG BINARY
COPY --from=builder /orivane-binaries/${BINARY} /usr/local/bin/orivane-service

USER orivane
ENTRYPOINT ["/usr/local/bin/orivane-service"]
