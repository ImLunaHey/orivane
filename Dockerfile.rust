FROM rust:1.94-bookworm AS chef

ARG CARGO_CHEF_VERSION=0.1.78
RUN cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}

WORKDIR /workspace

FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY crates ./crates
COPY modules ./modules

RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /workspace/recipe.json recipe.json
RUN cargo chef cook --locked --release --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY crates ./crates
COPY modules ./modules

RUN cargo build --locked --release \
      --package discord-bot-api \
      --package discord-bot-gateway \
      --package discord-bot-mcp \
    && mkdir /orivane-binaries \
    && cp target/release/discord-bot-api target/release/discord-bot-gateway \
      target/release/discord-bot-mcp /orivane-binaries/

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 orivane

ARG BINARY
COPY --from=builder /orivane-binaries/${BINARY} /usr/local/bin/orivane-service

USER orivane
ENTRYPOINT ["/usr/local/bin/orivane-service"]
